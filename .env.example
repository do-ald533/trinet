# Copy to `.env` (gitignored) to override the defaults of deploy/compose.yaml. Read by `make`
# targets via `docker compose --env-file .env`. NO SECRETS HERE: the API key lives in
# secrets/api_key (gitignored, created by `make secrets`) and is mounted as a file.

# Image started by compose. Production-like runs pin the published image by digest:
#   TRINET_IMAGE=ghcr.io/<owner>/trinet-api@sha256:<digest>   (use `make deploy`, it verifies first)
TRINET_IMAGE=trinet-api:local

# Base images for `docker compose build` / `make build`. The default `slim` is the pinned
# python:3.13-slim-trixie stage of deploy/Dockerfile: free, no login. Optional alternative
# (BASE=dhi, free Docker account + `docker login dhi.io`): see deploy/README.md.
BASE_IMAGE=slim
BUILD_IMAGE=slim

# Published ports are bound to 127.0.0.1 only.
TRINET_API_PORT=8000
PROMETHEUS_PORT=9090

# API settings (prefix TRINET_), see PLANO section 5.4 / 5.5.
TRINET_LOG_LEVEL=INFO
TRINET_MAX_CONCURRENCY=2
TRINET_ORT_INTRA_OP_THREADS=1
TRINET_RATE_LIMIT=60/minute
TRINET_MAX_BATCH=256
