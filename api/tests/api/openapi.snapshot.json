{
  "components": {
    "schemas": {
      "CategoricalField": {
        "additionalProperties": false,
        "description": "Raw categorical request field with a closed vocabulary (fitted on the training split).",
        "properties": {
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "impute": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Impute"
          },
          "kind": {
            "const": "categorical",
            "default": "categorical",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "title": "Name",
            "type": "string"
          },
          "vocabulary": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Vocabulary",
            "type": "array"
          }
        },
        "required": [
          "name",
          "vocabulary"
        ],
        "title": "CategoricalField",
        "type": "object"
      },
      "ClassScoreDto": {
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "probability": {
            "title": "Probability",
            "type": "number"
          }
        },
        "required": [
          "label",
          "probability"
        ],
        "title": "ClassScoreDto",
        "type": "object"
      },
      "ClassificationOutput": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "classification",
            "default": "classification",
            "title": "Kind",
            "type": "string"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "title": "Labels",
            "type": "array"
          }
        },
        "required": [
          "labels"
        ],
        "title": "ClassificationOutput",
        "type": "object"
      },
      "ClassificationPrediction": {
        "properties": {
          "kind": {
            "const": "classification",
            "default": "classification",
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "probabilities": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Probabilities",
            "type": "object"
          },
          "probability": {
            "title": "Probability",
            "type": "number"
          }
        },
        "required": [
          "label",
          "probability",
          "probabilities"
        ],
        "title": "ClassificationPrediction",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "ImageInput": {
        "additionalProperties": false,
        "description": "Encoded image -> RGB float32 array in ``value_range`` (rescaling happens in the graph).",
        "properties": {
          "channels": {
            "const": 3,
            "default": 3,
            "title": "Channels",
            "type": "integer"
          },
          "formats": {
            "default": [
              "JPEG",
              "PNG"
            ],
            "items": {
              "enum": [
                "JPEG",
                "PNG",
                "WEBP"
              ],
              "type": "string"
            },
            "title": "Formats",
            "type": "array"
          },
          "height": {
            "exclusiveMinimum": 0.0,
            "maximum": 4096.0,
            "title": "Height",
            "type": "integer"
          },
          "kind": {
            "const": "image",
            "default": "image",
            "title": "Kind",
            "type": "string"
          },
          "max_bytes": {
            "default": 5242880,
            "exclusiveMinimum": 0.0,
            "title": "Max Bytes",
            "type": "integer"
          },
          "resample": {
            "const": "bilinear",
            "default": "bilinear",
            "title": "Resample",
            "type": "string"
          },
          "value_range": {
            "default": [
              0.0,
              255.0
            ],
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Value Range",
            "type": "array"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "maximum": 4096.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "height",
          "width"
        ],
        "title": "ImageInput",
        "type": "object"
      },
      "ImagePrediction": {
        "properties": {
          "kind": {
            "const": "image_classification",
            "default": "image_classification",
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "probability": {
            "title": "Probability",
            "type": "number"
          },
          "top_k": {
            "items": {
              "$ref": "#/components/schemas/ClassScoreDto"
            },
            "title": "Top K",
            "type": "array"
          }
        },
        "required": [
          "label",
          "probability",
          "top_k"
        ],
        "title": "ImagePrediction",
        "type": "object"
      },
      "ModelDetail": {
        "description": "Public view of a manifest: no file names, no file hashes.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "input": {
            "discriminator": {
              "mapping": {
                "image": "#/components/schemas/ImageInput",
                "tabular": "#/components/schemas/TabularInput"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/TabularInput"
              },
              {
                "$ref": "#/components/schemas/ImageInput"
              }
            ],
            "title": "Input"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/TensorSpec"
            },
            "title": "Inputs",
            "type": "array"
          },
          "metrics": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            "title": "Metrics",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "output": {
            "discriminator": {
              "mapping": {
                "classification": "#/components/schemas/ClassificationOutput",
                "regression": "#/components/schemas/RegressionOutput"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/ClassificationOutput"
              },
              {
                "$ref": "#/components/schemas/RegressionOutput"
              }
            ],
            "title": "Output"
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/TensorSpec"
            },
            "title": "Outputs",
            "type": "array"
          },
          "quality_gate": {
            "$ref": "#/components/schemas/QualityGate"
          },
          "runtime": {
            "title": "Runtime",
            "type": "string"
          },
          "serving_skew": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ServingSkew"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "task": {
            "$ref": "#/components/schemas/Task"
          },
          "training": {
            "$ref": "#/components/schemas/TrainingPublic"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "status",
          "task",
          "description",
          "created_at",
          "runtime",
          "input",
          "output",
          "inputs",
          "outputs",
          "metrics",
          "quality_gate",
          "serving_skew",
          "training"
        ],
        "title": "ModelDetail",
        "type": "object"
      },
      "ModelList": {
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelSummary"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": [
          "models"
        ],
        "title": "ModelList",
        "type": "object"
      },
      "ModelSummary": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "metrics": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            "title": "Metrics",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the model cannot serve.",
            "title": "Reason"
          },
          "runtime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runtime"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Status"
              },
              {
                "type": "null"
              }
            ]
          },
          "task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Task"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "name",
          "version",
          "available"
        ],
        "title": "ModelSummary",
        "type": "object"
      },
      "NumericField": {
        "additionalProperties": false,
        "description": "Raw numeric request field. ``impute`` is used when the value is null/missing.",
        "properties": {
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "impute": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Impute"
          },
          "kind": {
            "const": "numeric",
            "default": "numeric",
            "title": "Kind",
            "type": "string"
          },
          "maximum": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maximum"
          },
          "minimum": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minimum"
          },
          "name": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "NumericField",
        "type": "object"
      },
      "OneHotFeature": {
        "additionalProperties": false,
        "description": "``len(vocabulary)`` columns, in vocabulary order, for a categorical field.",
        "properties": {
          "kind": {
            "const": "one_hot",
            "default": "one_hot",
            "title": "Kind",
            "type": "string"
          },
          "source": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "title": "OneHotFeature",
        "type": "object"
      },
      "PassthroughFeature": {
        "additionalProperties": false,
        "description": "One column: the (imputed) value of a numeric field.",
        "properties": {
          "kind": {
            "const": "passthrough",
            "default": "passthrough",
            "title": "Kind",
            "type": "string"
          },
          "source": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "title": "PassthroughFeature",
        "type": "object"
      },
      "PredictionResponse": {
        "properties": {
          "model_name": {
            "title": "Model Name",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "predictions": {
            "items": {
              "discriminator": {
                "mapping": {
                  "classification": "#/components/schemas/ClassificationPrediction",
                  "image_classification": "#/components/schemas/ImagePrediction",
                  "regression": "#/components/schemas/RegressionPrediction"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ClassificationPrediction"
                },
                {
                  "$ref": "#/components/schemas/RegressionPrediction"
                },
                {
                  "$ref": "#/components/schemas/ImagePrediction"
                }
              ]
            },
            "title": "Predictions",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "model_name",
          "model_version",
          "request_id",
          "predictions"
        ],
        "title": "PredictionResponse",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem object plus ``code``, ``request_id`` and (for 422) ``errors``.",
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Stable machine-readable error code.",
            "title": "Code"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProblemIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Request path.",
            "title": "Instance"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "URI identifying the problem type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ProblemIssue": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "loc": {
            "description": "Path to the offending value, e.g. instances.0.Area",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "code",
          "message"
        ],
        "title": "ProblemIssue",
        "type": "object"
      },
      "QualityGate": {
        "additionalProperties": false,
        "description": "Export-time gate: the notebook refuses to write the artifact if it does not pass.",
        "properties": {
          "higher_is_better": {
            "default": true,
            "title": "Higher Is Better",
            "type": "boolean"
          },
          "metric": {
            "minLength": 1,
            "title": "Metric",
            "type": "string"
          },
          "split": {
            "default": "validation",
            "enum": [
              "validation",
              "test"
            ],
            "title": "Split",
            "type": "string"
          },
          "threshold": {
            "title": "Threshold",
            "type": "number"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "metric",
          "threshold",
          "value"
        ],
        "title": "QualityGate",
        "type": "object"
      },
      "RatioFeature": {
        "additionalProperties": false,
        "description": "One column: ``numerator / denominator`` of two (imputed) numeric fields.",
        "properties": {
          "denominator": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "title": "Denominator",
            "type": "string"
          },
          "kind": {
            "const": "ratio",
            "default": "ratio",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "title": "Name",
            "type": "string"
          },
          "numerator": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "title": "Numerator",
            "type": "string"
          }
        },
        "required": [
          "name",
          "numerator",
          "denominator"
        ],
        "title": "RatioFeature",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "models": {
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Model name -> can serve predictions.",
            "title": "Models",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "models"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "RegressionOutput": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "regression",
            "default": "regression",
            "title": "Kind",
            "type": "string"
          },
          "target": {
            "minLength": 1,
            "title": "Target",
            "type": "string"
          },
          "unit": {
            "default": "",
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "title": "RegressionOutput",
        "type": "object"
      },
      "RegressionPrediction": {
        "properties": {
          "kind": {
            "const": "regression",
            "default": "regression",
            "title": "Kind",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "value",
          "unit",
          "target"
        ],
        "title": "RegressionPrediction",
        "type": "object"
      },
      "ServingSkew": {
        "additionalProperties": false,
        "description": "Training (Keras) vs serving (exported runtime + API preprocessing) agreement.",
        "properties": {
          "accuracy_delta_pp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy Delta Pp"
          },
          "max_abs_diff": {
            "minimum": 0.0,
            "title": "Max Abs Diff",
            "type": "number"
          },
          "samples": {
            "exclusiveMinimum": 0.0,
            "title": "Samples",
            "type": "integer"
          },
          "top1_agreement": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top1 Agreement"
          }
        },
        "required": [
          "samples",
          "max_abs_diff"
        ],
        "title": "ServingSkew",
        "type": "object"
      },
      "Status": {
        "enum": [
          "dummy",
          "candidate",
          "release"
        ],
        "title": "Status",
        "type": "string"
      },
      "TabularInput": {
        "additionalProperties": false,
        "description": "Raw named fields -> ordered float32 feature vector (``features`` order = column order).",
        "properties": {
          "features": {
            "items": {
              "discriminator": {
                "mapping": {
                  "one_hot": "#/components/schemas/OneHotFeature",
                  "passthrough": "#/components/schemas/PassthroughFeature",
                  "ratio": "#/components/schemas/RatioFeature"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/PassthroughFeature"
                },
                {
                  "$ref": "#/components/schemas/OneHotFeature"
                },
                {
                  "$ref": "#/components/schemas/RatioFeature"
                }
              ]
            },
            "minItems": 1,
            "title": "Features",
            "type": "array"
          },
          "fields": {
            "items": {
              "discriminator": {
                "mapping": {
                  "categorical": "#/components/schemas/CategoricalField",
                  "numeric": "#/components/schemas/NumericField"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/NumericField"
                },
                {
                  "$ref": "#/components/schemas/CategoricalField"
                }
              ]
            },
            "minItems": 1,
            "title": "Fields",
            "type": "array"
          },
          "kind": {
            "const": "tabular",
            "default": "tabular",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "fields",
          "features"
        ],
        "title": "TabularInput",
        "type": "object"
      },
      "Task": {
        "enum": [
          "classification",
          "regression",
          "image_classification"
        ],
        "title": "Task",
        "type": "string"
      },
      "TensorSpec": {
        "additionalProperties": false,
        "description": "A graph input/output tensor. ``None`` in ``shape`` marks a dynamic (batch) axis.",
        "properties": {
          "dtype": {
            "const": "float32",
            "default": "float32",
            "title": "Dtype",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "shape": {
            "items": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "minItems": 1,
            "title": "Shape",
            "type": "array"
          }
        },
        "required": [
