  "info": {
    "description": "Inference API for the TriNet financial-market models: credit default (binary classification), 5-day realised volatility (regression) and candlestick chart regimes (image classification). Behaviour is driven by each model's `manifest.json`; errors follow RFC 9457.\n\n**Educational use only.** The models are demonstrations of an ML deployment pipeline. Nothing returned by this API is investment, credit or financial advice, and it must not be used to make real financial decisions.",
    "title": "TriNet inference API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
