            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Model name, as listed by GET /v1/models.",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "title": "Name",
              "type": "string"
            }
          }
        ],
