    "/v1/models/{name}/predictions": {
      "post": {
        "operationId": "create_prediction",
        "parameters": [
          {
            "description": "Model name, as listed by GET /v1/models.",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Model name, as listed by GET /v1/models.",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "instances": {
                    "items": {
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "type": "object"
                    },
                    "maxItems": 256,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "instances"
                ],
                "type": "object"
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "description": "Tabular models: JSON with raw named fields (see GET /v1/models/{name}). Image models: multipart/form-data with a single `file` part.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Model-Version": {
                "description": "Version of the model that produced the answer.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
